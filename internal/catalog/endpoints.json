      }
    ]
  },
  {
    "section": "Hashrate Distribution",
    "title": "List of all orders of hashrate distribution",
    "path": "/v2/hash_rate/distribution/orders",
    "fields": [
      {
        "name": "currency",
        "type": "string",
        "repeated": false,
        "description": "Currency type"
      },
      {
        "name": "distributor",
        "type": "string",
        "repeated": false,
        "description": "The distributor account name"
      },
      {
        "name": "start_date",
        "type": "int64",
        "repeated": false,
        "description": "UTC Unix timestamp (seconds or 13-digit milliseconds). With end_date, forms half-open range [start_date, end_date). Filters orders that overlap the window: end_timestamp >= start_date and start_timestamp < end_date."
      },
      {
        "name": "end_date",
        "type": "int64",
        "repeated": false,
        "description": "See start_date. Must be greater than start_date when both are set."
      },
      {
        "name": "external_id",
        "type": "string",
        "repeated": false,
        "description": "Hex string (optional 0x prefix), same as when creating the distribution. When set, only orders with this external_id are returned."
      }
    ]
  },
  {
    "section": "Hashrate Distribution",
    "title": "List of all settlements of hashrate distribution",
    "path": "/v2/hash_rate/distribution/settlements",
    "fields": [
      {
        "name": "currency",
        "type": "string",
        "repeated": false,
        "description": "Currency type"
      },
      {
        "name": "distributor",
        "type": "string",
        "repeated": false,
        "description": "The distributor account name"
      },
      {
        "name": "start_date",
        "type": "int64",
        "repeated": false,
        "description": "UTC Unix timestamp (seconds or 13-digit milliseconds). With end_date, forms half-open range [start_date, end_date). Filters settlements where timestamp >= start_date and timestamp < end_date."
      },
      {
        "name": "end_date",
        "type": "int64",
        "repeated": false,
        "description": "See start_date. Must be greater than start_date when both are set."
      },
      {
        "name": "external_id",
        "type": "string",
        "repeated": false,
        "description": "Hex string (optional 0x prefix), matching the linked distribution order. When set, only settlements for orders with this external_id are returned."
      }
    ]
  },
